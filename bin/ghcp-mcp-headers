#!/usr/bin/env python3
"""Desktop headersHelper: stdout is one JSON object; diagnostics never include secrets."""
import json
import os
import subprocess
import sys


def main():
    if len(sys.argv) != 2 or not os.path.isabs(sys.argv[1]):
        raise ValueError("expected the absolute gh executable path")
    result = subprocess.run(
        [sys.argv[1], "auth", "token", "--hostname", "github.com"],
        capture_output=True, text=True, timeout=20, check=False,
        stdin=subprocess.DEVNULL,
    )
    token = result.stdout.strip()
    if result.returncode or not token or any(c.isspace() or ord(c) < 33 or ord(c) == 127 for c in token):
        raise ValueError("gh did not return a single valid token")
    print(json.dumps({"Authorization": "Bearer " + token}, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("ghcp-mcp-headers: credential acquisition failed", file=sys.stderr)
        sys.exit(1)
